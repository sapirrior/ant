{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AntErrorResult",
  "description": "Standard single-object JSON response emitted on stdout when ant run fails after startup.",
  "type": "object",
  "required": [
    "schema_version",
    "type",
    "subtype",
    "is_error",
    "exit_code",
    "error",
    "num_turns",
    "duration_ms",
    "model"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "type": { "type": "string", "const": "result" },
    "subtype": {
      "type": "string",
      "enum": [
        "max_turns",
        "truncated",
        "empty_response",
        "usage_error",
        "model_error",
        "timeout",
        "internal_error",
        "cancelled"
      ],
      "example": "max_turns"
    },
    "is_error": { "type": "boolean", "const": true },
    "exit_code": { "type": "integer", "minimum": 1, "example": 1 },
    "result": {
      "type": ["string", "null"],
      "example": "Partial output generated before reaching turn limit"
    },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "example": "max_turns_exceeded" },
        "message": { "type": "string", "example": "Agent reached maximum turns limit (5)" }
      }
    },
    "session_id": { "type": ["string", "null"], "example": "0194eb47-a123-7bcd-8ef0-123456789abc" },
    "num_turns": { "type": "integer", "minimum": 0, "example": 5 },
    "duration_ms": { "type": "integer", "minimum": 0, "example": 4510 },
    "model": { "type": "string", "example": "anthropic/claude-3-7-sonnet-20250219" },
    "effort": { "type": ["string", "null"] },
    "usage": {
      "type": "object",
      "properties": {
        "input_tokens": { "type": "integer" },
        "output_tokens": { "type": "integer" },
        "total_tokens": { "type": "integer" },
        "cached_tokens": { "type": "integer" }
      }
    },
    "checkpoints": {
      "type": "array",
      "items": { "type": "integer" },
      "example": []
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" },
      "example": []
    }
  }
}
