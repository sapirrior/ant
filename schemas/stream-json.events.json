{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AntStreamJsonEvents",
  "description": "Array of example NDJSON events streamed sequentially on stdout during `stream-json` execution.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["schema_version", "type", "seq", "ts"],
    "properties": {
      "schema_version": { "type": "integer", "const": 1 },
      "seq": { "type": "integer", "minimum": 0 },
      "ts": { "type": "string", "format": "date-time" },
      "type": {
        "type": "string",
        "enum": ["init", "text-delta", "tool-call", "tool-result", "warning", "result"]
      }
    }
  },
  "examples": [
    {
      "schema_version": 1,
      "seq": 0,
      "ts": "2026-10-16T06:50:00.000Z",
      "type": "init",
      "model": "google/gemini-2.5-flash",
      "permission_mode": "default",
      "tools": ["ReadFile", "ListDir", "Grep", "WebSearch", "WebFetch"],
      "session_id": "0194eb47-a123-7bcd-8ef0-123456789abc",
      "ant_version": "1.0.0"
    },
    {
      "schema_version": 1,
      "seq": 1,
      "ts": "2026-10-16T06:50:00.320Z",
      "type": "tool-call",
      "call_id": "call_123",
      "tool": "ReadFile",
      "input": { "path": "package.json" }
    },
    {
      "schema_version": 1,
      "seq": 2,
      "ts": "2026-10-16T06:50:00.350Z",
      "type": "tool-result",
      "call_id": "call_123",
      "tool": "ReadFile",
      "output": { "content": "{\n  \"name\": \"ant\"\n}" },
      "duration_ms": 30,
      "is_error": false,
      "truncated": false
    },
    {
      "schema_version": 1,
      "seq": 3,
      "ts": "2026-10-16T06:50:00.600Z",
      "type": "text-delta",
      "delta": "This package is named ant."
    },
    {
      "schema_version": 1,
      "seq": 4,
      "ts": "2026-10-16T06:50:01.000Z",
      "type": "result",
      "subtype": "success",
      "is_error": false,
      "exit_code": 0,
      "result": "This package is named ant.",
      "session_id": "0194eb47-a123-7bcd-8ef0-123456789abc",
      "num_turns": 1,
      "duration_ms": 1000,
      "model": "google/gemini-2.5-flash"
    }
  ]
}
