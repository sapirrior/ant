{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AntStreamJsonEvent",
  "description": "Single NDJSON event emitted line-by-line on stdout during `stream-json` execution.",
  "type": "object",
  "oneOf": [
    {
      "title": "StreamInitEvent",
      "type": "object",
      "required": ["schema_version", "seq", "ts", "type", "model", "permission_mode", "tools"],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "ts": {
          "type": "string",
          "format": "date-time"
        },
        "type": {
          "type": "string",
          "const": "init"
        },
        "model": {
          "type": "string"
        },
        "permission_mode": {
          "type": "string",
          "enum": ["default", "plan", "acceptEdits", "bypassPermissions"]
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "session_id": {
          "type": ["string", "null"]
        },
        "ant_version": {
          "type": "string"
        }
      }
    },
    {
      "title": "StreamTextDeltaEvent",
      "type": "object",
      "required": ["schema_version", "seq", "ts", "type", "delta"],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "ts": {
          "type": "string",
          "format": "date-time"
        },
        "type": {
          "type": "string",
          "const": "text-delta"
        },
        "delta": {
          "type": "string"
        }
      }
    },
    {
      "title": "StreamToolCallEvent",
      "type": "object",
      "required": ["schema_version", "seq", "ts", "type", "call_id", "tool", "input"],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "ts": {
          "type": "string",
          "format": "date-time"
        },
        "type": {
          "type": "string",
          "const": "tool-call"
        },
        "call_id": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "input": {},
        "truncated": {
          "type": "boolean"
        },
        "original_size": {
          "type": "integer"
        }
      }
    },
    {
      "title": "StreamToolResultEvent",
      "type": "object",
      "required": [
        "schema_version",
        "seq",
        "ts",
        "type",
        "call_id",
        "tool",
        "output",
        "duration_ms",
        "is_error"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "ts": {
          "type": "string",
          "format": "date-time"
        },
        "type": {
          "type": "string",
          "const": "tool-result"
        },
        "call_id": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "output": {},
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "is_error": {
          "type": "boolean"
        },
        "truncated": {
          "type": "boolean"
        },
        "original_size": {
          "type": "integer"
        }
      }
    },
    {
      "title": "StreamWarningEvent",
      "type": "object",
      "required": ["schema_version", "seq", "ts", "type", "message"],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "ts": {
          "type": "string",
          "format": "date-time"
        },
        "type": {
          "type": "string",
          "const": "warning"
        },
        "message": {
          "type": "string"
        }
      }
    },
    {
      "title": "StreamResultEvent",
      "type": "object",
      "required": [
        "schema_version",
        "seq",
        "ts",
        "type",
        "subtype",
        "is_error",
        "exit_code",
        "num_turns",
        "duration_ms",
        "model"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "ts": {
          "type": "string",
          "format": "date-time"
        },
        "type": {
          "type": "string",
          "const": "result"
        },
        "subtype": {
          "type": "string"
        },
        "is_error": {
          "type": "boolean"
        },
        "exit_code": {
          "type": "integer"
        },
        "result": {
          "type": ["string", "null"]
        },
        "error": {
          "type": ["object", "null"],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        },
        "session_id": {
          "type": ["string", "null"]
        },
        "num_turns": {
          "type": "integer",
          "minimum": 0
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "model": {
          "type": "string"
        },
        "effort": {
          "type": ["string", "null"]
        },
        "usage": {
          "type": ["object", "null"]
        },
        "checkpoints": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  ]
}
