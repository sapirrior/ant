{
  "name": "ant",
  "version": "0.8.1",
  "description": "A daily-use, streaming, model-agnostic AI agent CLI",
  "type": "module",
  "private": true,
  "engines": {
    "bun": ">=1.2"
  },
  "main": "./src/main.ts",
  "bin": {
    "ant": "./src/main.ts"
  },
  "scripts": {
    "start": "bun --no-env-file run src/main.ts",
    "dev": "bun --no-env-file --watch run src/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "bundle": "bun build --target=bun src/main.ts --outfile=dist/ant.js && chmod +x dist/ant.js",
    "build": "bun build --compile --no-env-file src/main.ts --outfile=ant",
    "build:linux-x64": "bun build --compile --no-env-file --target=bun-linux-x64 src/main.ts --outfile=dist/ant-linux-x64",
    "build:linux-arm64": "bun build --compile --no-env-file --target=bun-linux-arm64 src/main.ts --outfile=dist/ant-linux-arm64",
    "build:darwin-x64": "bun build --compile --no-env-file --target=bun-darwin-x64 src/main.ts --outfile=dist/ant-darwin-x64",
    "build:darwin-arm64": "bun build --compile --no-env-file --target=bun-darwin-arm64 src/main.ts --outfile=dist/ant-darwin-arm64",
    "build:windows-x64": "bun build --compile --no-env-file --target=bun-windows-x64 src/main.ts --outfile=dist/ant-windows-x64.exe",
    "build:all": "bun run bundle && bun run build:linux-x64 && bun run build:linux-arm64 && bun run build:darwin-x64 && bun run build:darwin-arm64 && bun run build:windows-x64"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.78",
    "@ai-sdk/deepseek": "^3.0.64",
    "@ai-sdk/google": "4.0.93",
    "@ai-sdk/groq": "^4.0.60",
    "@ai-sdk/mcp": "2.0.74",
    "@ai-sdk/openai": "^4.0.92",
    "@ai-sdk/openai-compatible": "3.0.67",
    "@ai-sdk/xai": "^5.0.21",
    "ai": "7.0.137",
    "cli-highlight": "^2.1.11",
    "commander": "14.0.3",
    "marked": "^18.1.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "^5"
  }
}
